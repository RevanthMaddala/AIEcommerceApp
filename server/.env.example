# Copy to server/.env and fill in what you have. Everything is optional:
# with no keys the app runs in quick mode against the demo catalog.

# ── AI agent ──────────────────────────────────────────────────────
# Set either key. With AI_PROVIDER=auto, Claude is used if its key is set,
# otherwise Gemini, otherwise the rule-based quick mode.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# AI_PROVIDER=auto        # auto | claude | gemini | heuristic

# ── Market ────────────────────────────────────────────────────────
# IN = Google India: Amazon.in, Flipkart, Croma, Tata CLiQ, ... with prices in ₹
# US = the default. Best Buy and eBay are US-only and switch off outside the US.
# REGION=IN

# ── Store APIs (each one adds a platform) ─────────────────────────
# Best Buy: https://developer.bestbuy.com
BESTBUY_API_KEY=
# eBay Browse API (production keyset): https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
# Google Shopping via SerpApi (Amazon, Walmart, Target, ... offers): https://serpapi.com
SERPAPI_KEY=
# Turn off the keyless demo catalog once real stores are connected
# ENABLE_DEMO_CATALOG=false

# ── Tuning ────────────────────────────────────────────────────────
# PORT=4000
# PROVIDER_TIMEOUT_MS=6000
# Top picks that get every store's price and link (Flipkart, Amazon, ...); 1 SerpApi search each, 0 = off
# AUTO_STORE_LOOKUPS=3
# CACHE_TTL_SECONDS=300
